# Optional. Copy to .env for a local source checkout.
MATTER_LAB_HOST=127.0.0.1
MATTER_LAB_PORT=4310
MATTER_LAB_DATA_DIR=./data

# Leave unset for local rendering on macOS.
# A container release launcher configures its authenticated render worker.
# MATTER_LAB_RENDER_WORKER_URL=http://127.0.0.1:4316
# MATTER_LAB_RENDER_WORKER_TOKEN=use-a-generated-private-token-of-at-least-32-characters
